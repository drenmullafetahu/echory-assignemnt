# Track A — copy this file to .env at the repo root, then edit it.
# Free Groq key: https://console.groq.com/keys
# Free Gemini key: https://aistudio.google.com/apikey
# Local models: ollama pull llama3.2:3b && ollama pull llama3.2:1b
# Then set LLM_PROVIDER=ollama. OLLAMA_MODEL picks the startup local model.
#
# llama-3.1-8b-instant left the Groq free tier on 2026-08-16.
# qwen/qwen3.8-27b is the startup model. The client sends reasoning_effort none.
# openai/gpt-oss-20b remains available and uses reasoning_effort low.

PORT=3000
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Billed per token. https://platform.openai.com/api-keys
# gpt-4.1-nano does not run a reasoning step. Set LLM_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_MS=420
LLM_MAX_TOKENS=160
CACHE_MAX=500
